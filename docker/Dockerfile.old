# ==============================================================================
# DOCKERFILE CŨ (LẤY TỪ PIPELINE JENKINS GỐC)
# Dùng để tham chiếu và so sánh
# ==============================================================================

# Stage 1: Build source code (lỗi warning do chữ 'as' viết thường ở line 1)
FROM 10.29.75.6/ipcc2.0/node:14.21.2-alpine3.16 as builder

WORKDIR /app

# Copy dependency files và cài đặt package
COPY package*.json ./
RUN npm install

# Copy toàn bộ mã nguồn
COPY . .

# Build ứng dụng frontend (Angular)
# Lưu ý kiểm tra tham số: --configuration=production hoặc --configuration=k8s
RUN npm run build -- --configuration=production

# Stage 2: Nginx Runtime
FROM 10.29.75.6/ipcc2.0/nginx:1.23.3-alpine

# Copy kết quả build từ stage builder sang thư mục phục vụ web của Nginx
COPY --from=builder /app/dist/webapps /usr/share/nginx/html/

# Di chuyển thư mục assets/register ra ngoài thư mục html (Step #17 trong log)
RUN mv /usr/share/nginx/html/assets/register /usr/share/nginx/html/

# Copy file cấu hình nginx tùy chỉnh (nếu dự án có dùng nginx.conf riêng)
# COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
